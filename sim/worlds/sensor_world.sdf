<sdf version='1.9'>
  <world name='empty'>
    <physics name='1ms' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='ignition-gazebo-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='ignition-gazebo-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='ignition-gazebo-contact-system'/>
    
    <plugin name='ignition::gazebo::systems::Sensors' filename='ignition-gazebo-sensors-system'/>
   
    <gravity>0 0 -9.8</gravity>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
  <!-- ================= FLAT VINEYARD GROUND ================= -->
<model name="vineyard_ground">
  <static>true</static>

  <!-- Centered between x=1 and x=-99 -->
  <!-- Midpoint = -49 -->
  <pose>-48 0 -0.6 0 0 0</pose>

  <!-- ===== Collision ===== -->
  <link name="ground_link">
    <collision name="collision">
      <geometry>
        <box>
          <size>100 5 0.2</size>
        </box>
      </geometry>
      <surface>
        <contact>
          <collide_without_contact>false</collide_without_contact>
        </contact>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <!-- ===== Visual ===== -->
    <visual name="visual">
      <geometry>
        <box>
          <size>100 5 0.2</size>
        </box>
      </geometry>
      <material>
        <ambient>0.3 0.6 0.3 1</ambient>
        <diffuse>0.3 0.6 0.3 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </link>
</model>

    <!-- ========================================================= -->
    <!--  Vineyard heightmap terrain (50m x 50m, ~0.5m height span) -->
    <!--  Put vineyard_heightmap.png next to this world file, or   -->
    <!--  change the <uri> path to wherever you saved it.          -->
    <!-- ========================================================= -->
  <model name="vineyard_mesh_inline">
    <static>true</static>
    <!-- x  y   z    R    P      Y(=90deg) -->
    <pose>0 0 -0.4 0 0 1.5707963</pose>
    <link name="terrain">
      <collision name="col">
        <geometry>
          <mesh>
            <uri>file:///home/alex/.ignition/gazebo/models/vineyard_mesh/meshes/5050vinefinal.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="vis">
        <geometry>
          <mesh>
            <uri>file:///home/alex/.ignition/gazebo/models/vineyard_mesh/meshes/5050vinefinal.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.4 0.3 0.2 1</ambient>
          <diffuse>0.45 0.35 0.25 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>


    <!-- =========== INLINE VINE POSTS + RED BALLS =========== -->
    <!-- Helper chunk reused in every post:
         - cylinder post: radius 0.05, length 1.2, centered at z=0.6
         - red ball: radius 0.07, centered at z=1.0
         Only pose of the MODEL changes (x,y,z). -->

    <!-- ROW 1: Y = +1.1 -->

    <model name='row1_post_00'>
      <static>true</static>
      <pose>0 1.1 -0.5 0 0 0</pose>
      <link name='vine_link'>
        <collision name='post_collision'>
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>
          <pose>0 0 0.6 0 0 0</pose>
        </collision>
        <visual name='post_visual'>
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>
          <pose>0 0 0.6 0 0 0</pose>
          <material>
            <diffuse>0.4 0.3 0.2 1</diffuse>
            <ambient>0.4 0.3 0.2 1</ambient>
          </material>
        </visual>
        <collision name='ball_collision'>
          <geometry>
            <sphere>
              <radius>0.07</radius>
            </sphere>
          </geometry>
          <pose>0 0 1.0 0 0 0</pose>
        </collision>
        <visual name='ball_visual'>
