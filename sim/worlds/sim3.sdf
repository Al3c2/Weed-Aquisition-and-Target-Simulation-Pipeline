  <!-- ================= FLAT VINEYARD GROUND ================= -->
<model name="vineyard_ground">
  <static>true</static>

  <!-- Centered between x=1 and x=-99 -->
  <!-- Midpoint = -49 -->
  <pose>-48 0 -0.6 0 0 0</pose>

  <!-- ===== Collision ===== -->
  <link name="ground_link">
    <collision name="collision">
      <geometry>
        <box>
          <size>100 5 0.2</size>
        </box>
      </geometry>
      <surface>
        <contact>
          <collide_without_contact>false</collide_without_contact>
        </contact>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <!-- ===== Visual ===== -->
    <visual name="visual">
      <geometry>
        <box>
          <size>100 5 0.2</size>
        </box>
      </geometry>
      <material>
        <ambient>0.3 0.6 0.3 1</ambient>
        <diffuse>0.3 0.6 0.3 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </link>
</model>
































